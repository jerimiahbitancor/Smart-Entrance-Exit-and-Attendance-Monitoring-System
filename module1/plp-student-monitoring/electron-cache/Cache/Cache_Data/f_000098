le,\r\n.step-done    .step-subtitle { color: var(--color-primary-dark); opacity: 0.75; }\r\n.step-pending .step-title,\r\n.step-pending .step-subtitle { color: #bbb; }\r\n/* Connector line that stretches between the two steps */\r\n.stepper-line {\r\n  flex: 1;\r\n  height: 2px;\r\n  background: #ddd;\r\n  margin: 0 14px;\r\n  border-radius: 2px;\r\n  transition: background 0.4s;\r\n}\r\n/* Fills green when Step 2 becomes active */\r\n.stepper-line.line-filled {\r\n  background: var(--color-primary-dark);\r\n}\r\n/* ── FIELD VALIDATION ERRORS ─*/\r\n/* Red border on invalid input/select */\r\n.input-group input.input-error,\r\n.input-group select.input-error {\r\n  border-color: var(--color-red);\r\n  background-color: #fff5f5;\r\n}\r\n.input-group input.input-error:focus,\r\n.input-group select.input-error:focus {\r\n  border-color: var(--color-red);\r\n  box-shadow: 0 0 0 2px rgba(255, 46, 46, 0.15);\r\n}\r\n/* Small red message below the field */\r\n.field-error {\r\n  display: block;\r\n  margin-top: 4px;\r\n  font-size: 0.76rem;\r\n  color: var(--color-red);\r\n  font-family: 'Montserrat', sans-serif;\r\n  font-weight: 500;\r\n}\r\n/* Required asterisk colour */\r\n.required {\r\n  color: var(--color-red);\r\n  margin-left: 2px;\r\n}\r\n/* Small note above the form */\r\n.form-note {\r\n  font-size: 0.78rem;\r\n  color: #888;\r\n  font-family: 'Montserrat', sans-serif;\r\n  margin-bottom: 14px;\r\n}\r\n/* ===== STEP 1: Student Information Form ===== */\r\n.register-form {\r\n  padding: 30px;\r\n  background-color: #ffffff;\r\n}\r\n.form-row {\r\n  display: flex;\r\n  gap: 20px;\r\n  margin-bottom: 20px;\r\n  flex-wrap: wrap;\r\n}\r\n.input-group {\r\n  flex: 1 1 calc(50% - 10px);\r\n  min-width: 200px;\r\n}\r\n.input-group label {\r\n  display: block;\r\n  font-weight: 600;\r\n  font-size: 0.9rem;\r\n  margin-bottom: 6px;\r\n  color: var(--color-text-dark);\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.4px;\r\n  font-family: 'Montserrat', sans-serif;\r