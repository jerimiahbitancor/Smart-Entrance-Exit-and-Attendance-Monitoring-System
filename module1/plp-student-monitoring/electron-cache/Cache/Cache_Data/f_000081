play: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  padding: 8px 16px;\r\n  border: none;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  transition: var(--transition);\r\n  white-space: nowrap;\r\n}\r\n\r\n.import-button {\r\n  background-color: #e8f0fe;\r\n  color: var(--color-primary-dark);\r\n}\r\n\r\n.import-button:hover {\r\n  background-color: #d1e2fc;\r\n}\r\n\r\n.add-button {\r\n  background-color: var(--color-primary-dark);\r\n  color: white;\r\n}\r\n\r\n.add-button:hover {\r\n  background-color: var(--color-primary);\r\n}\r\n\r\n.archive-button {\r\n  background-color: var(--color-primary-dark);\r\n  color: white;\r\n}\r\n\r\n.archive-button:hover:not(:disabled) {\r\n  background-color: var(--color-primary);\r\n}\r\n\r\n.archive-button:disabled {\r\n  background-color: #cccccc;\r\n  cursor: not-allowed;\r\n  opacity: 0.6;\r\n}\r\n\r\n.archive-buttons-section {\r\n  background-color: white;\r\n  padding: 20px;\r\n  border-radius: 8px;\r\n  box-shadow: 0 2px 4px var(--color-shadow-soft);\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.archive-section-title {\r\n  margin: 0 0 15px 0;\r\n  color: var(--color-text-dark);\r\n  font-size: 16px;\r\n  font-weight: 600;\r\n}\r\n\r\n.archive-buttons-group {\r\n  display: flex;\r\n  gap: 10px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.archive-buttons-group .archive-button {\r\n  flex: 1;\r\n  min-width: 200px;\r\n  padding: 10px 15px;\r\n  font-size: 14px;\r\n}\r\n\r\n.button-icon {\r\n  font-size: 16px;\r\n}\r\n\r\n/* Table Styles */\r\n.table-container {\r\n  background-color: white;\r\n  border-radius: 8px;\r\n  overflow-x: auto;\r\n  box-shadow: 0 2px 4px var(--color-shadow-soft);\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.student-table {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n  font-size: 14px;\r\n  min-width: 1000px;\r\n}\r\n\r\n.student-table thead {\r\n  background-color: var(--color-primary-dark);\r\n}\r\n\r\n.student-table th {\r\n  padding: 12px 15px;\r\n  text-align: left;\r\n  font-weight: 600;\r\n  font-size: 14px;\r\n  color: white;\r\n  white-space: nowrap;\r\n}\r\n\r\n.student-table tbody tr {\r\n  border-bottom: 1px solid #e9ecef;\r\n}\r\n\r\n.student-table tbody tr:hover {\r\n  background-color: #f8f9fa;\r\n  cursor: pointer;\r\n}\r\n\r\n.student-table td {\r\n  padding: 12px 15px;\r\n  font-size: 14px;\r\n  color: var(--color-text-black);\r\n}\r\n\r\n/* Status Badge */\r\n.status-badge {\r\n  display: inline-block;\r\n  padding: 4px 8px;\r\n  border-radius: 4px;\r\n  font-size: 12px;\r\n  font-weight: 500;\r\n  text-align: center;\r\n}\r\n\r\n.status-badge.active {\r\n  background-color: #d4edda;\r\n  color: var(--color-primary-dark);\r\n}\r\n\r\n.status-badge.inactive {\r\n  background-color: #f8d7da;\r\n  color: #721c24;\r\n}\r\n\r\n/* Action Buttons Container */\r\n.action-cell {\r\n  white-space: nowrap;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n}\r\n\r\n.action-buttons {\r\n  display: flex;\r\n  gap: 8px;\r\n  justify-content: flex-start;\r\n  align-items: center;\r\n}\r\n\r\n\r\n\r\n/* Individual Action Buttons */\r\n.action-btn {\r\n  width: 32px;\r\n  height: 32px;\r\n  border-radius: 4px;\r\n  border: none;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  cursor: pointer;\r\n  transition: all 0.2s ease;\r\n  font-size: 16px;\r\n  background-color: transparent;\r\n  color: var(--color-text-dark);\r\n}\r\n\r\n.action-btn:hover {\r\n  transform: translateY(-2px);\r\n}\r\n\r\n.edit-btn {\r\n  background-color: #e8f0fe;\r\n  color: var(--color-primary-dark);\r\n}\r\n\r\n.edit-btn:hover {\r\n  background-color: #d1e2fc;\r\n}\r\n\r\n.photo-btn {\r\n  background-color: #fff3cd;\r\n  color: #856404;\r\n}\r\n\r\n.photo-btn:hover {\r\n  background-color: #ffe69c;\r\n}\r\n\r\n.deactivate-btn {\r\n  background-color: #f8d7da;\r\n  color: #721c24;\r\n}\r\n\r\n.deactivate-btn:hover {\r\n  background-color: #f5c6cb;\r\n}\r\n\r\n.activate-btn {\r\n  background-color: #d4edda;\r\n  color: var(--color-primary-dark);\r\n}\r\n\r\n.activate-btn:hover {\r\n  background-color: #c3e6cb;\r\n}\r\n\r\n/* Pagination Styles */\r\n.pagination {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  gap: 20px;\r\n  margin-top: 20px;\r\n  padding: 10px 0;\r\n}\r\n\r\n.pagination-button {\r\n  padding: 8px 16px;\r\n  border: 1px solid #ddd;\r\n  background-color: white;\r\n  color: #333;\r\n  cursor: pointer;\r\n  border-radius: 4px;\r\n  font-size: 14px;\r\n  font-weight: 500;\r\n  transition: var(--transition);\r\n}\r\n\r\n.pagination-button:hover:not(:disabled) {\r\n  background-color: #f5f5f5;\r\n  border-color: var(--color-primary-dark);\r\n  color: var(--color-primary-dark);\r\n}\r\n\r\n.pagination-button:disabled {\r\n  opacity: 0.5;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.page-numbers {\r\n  display: flex;\r\n  gap: 8px;\r\n  align-items: center;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.page-number {\r\n  min-width: 36px;\r\n  height: 36px;\r\n  padding: 0 8px;\r\n  border: 1px solid #ddd;\r\n  background-color: white;\r\n  color: #333;\r\n  cursor: pointer;\r\n  border-radius: 4px;\r\n  font-size: 14px;\r\n  font-weight: 500;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  transition: var(--transition);\r\n}\r\n\r\n.page-number:hover {\r\n  background-color: #f5f5f5;\r\n  border-color: var(--color-primary-dark);\r\n  color: var(--color-primary-dark);\r\n}\r\n\r\n.page-number.active {\r\n  background-color: var(--color-primary-dark);\r\n  border-color: var(--color-primary-dark);\r\n  color: white;\r\n}\r\n\r\n.ellipsis {\r\n  color: #666;\r\n  padding: 0 5px;\r\n  font-size: 14px;\r\n}\r\n\r\n/* Modal Styles */\r\n.modal-overlay {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  right: 0;\r\n  bottom: 0;\r\n  background-color: rgba(0, 0, 0, 0.5);\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  z-index: 1000;\r\n  animation: fadeIn 0.3s ease;\r\n}\r\n\r\n.modal-content {\r\n  background-color: white;\r\n  border-radius: 8px;\r\n  max-width: 750px;\r\n  width: 90%;\r\n  max-height: 90vh;\r\n  overflow-y: auto;\r\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);\r\n  animation: slideIn 0.3s ease;\r\n}\r\n\r\n.modal-content .register-container {\r\n  margin: 0;\r\n  box-shadow: none;\r\n}\r\n\r\n/* Animations */\r\n@keyframes fadeIn {\r\n  from { opacity: 0; }\r\n  to { opacity: 1; }\r\n}\r\n\r\n@keyframes slideIn {\r\n  from { transform: translateY(-20px); opacity: 0; }\r\n  to { transform: translateY(0); opacity: 1; }\r\n}\r\n\r\n/* Responsive Design */\r\n@media (max-width: 1024px) {\r\n  .controls {\r\n    gap: 12px;\r\n  }\r\n  \r\n  .filter-select {\r\n    min-width: 130px;\r\n  }\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .controls {\r\n    flex-direction: column;\r\n    align-items: stretch;\r\n    gap: 15px;\r\n  }\r\n\r\n  .filter-select,\r\n  .search-input,\r\n  .action-button {\r\n    width: 100%;\r\n    min-width: auto;\r\n  }\r\n\r\n  .student-table {\r\n    font-size: 12px;\r\n  }\r\n  \r\n  .student-table th,\r\n  .student-table td {\r\n    padding: 8px 10px;\r\n  }\r\n\r\n  .action-buttons {\r\n    gap: 4px;\r\n  }\r\n  \r\n  .action-btn {\r\n    width: 28px;\r\n    height: 28px;\r\n    font-size: 14px;\r\n  }\r\n}\r\n\r\n@media (max-width: 480px) {\r\n  .student-management {\r\n    padding: 10px;\r\n  }\r\n  \r\n  .filter-select,\r\n  .search-input,\r\n  .action-button {\r\n    padding: 8px 10px;\r\n    font-size: 13px;\r\n  }\r\n  \r\n  .student-table {\r\n    font-size: 11px;\r\n  }\r\n  \r\n  .student-table th,\r\n  .student-table td {\r\n    padding: 6px 8px;\r\n  }\r\n  \r\n  .page-number {\r\n    min-width: 32px;\r\n    height: 32px;\r\n    font-size: 13px;\r\n  }\r\n}\r\n\r\n\r\n\r\n/* Action Buttons Text Styles */\r\n.action-buttons-text {\r\n  display: flex;\r\n  gap: 8px;\r\n  justify-content: center;\r\n  align-items: center;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.action-text-btn {\r\n  padding: 4px 10px;\r\n  border: none;\r\n  border-radius: 4px;\r\n  font-size: 14px;\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n  transition: all 0.2s ease;\r\n  white-space: nowrap;\r\n}\r\n\r\n.edit-text-btn {\r\n  background-color: #e8f0fe;\r\n  color: var(--color-primary-dark);\r\n}\r\n\r\n.edit-text-btn:hover {\r\n  background-color: #d1e2fc;\r\n  transform: translateY(-1px);\r\n}\r\n\r\n\r\n.deactivate-text-btn {\r\n  background-color: #f8d7da;\r\n  color: #721c24;\r\n}\r\n\r\n\r\n\r\n.activate-text-btn {\r\n  background-color: #d4edda;\r\n  color: var(--color-primary-dark);\r\n}\r\n\r\n\r\n\r\n/* Responsive adjustments */\r\n@media (max-width: 768px) {\r\n  .action-buttons-text {\r\n    gap: 4px;\r\n    flex-direction: column;\r\n    align-items: flex-start;\r\n  }\r\n  \r\n  .action-text-btn {\r\n    padding: 3px 8px;\r\n    font-size: 11px;\r\n    width: 100%;\r\n    text-align: center;\r\n  }\r\n}\r\n\r\n.student-id-cell {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  white-space: nowrap;\r\n}\r\n \r\n/* The dot itself */\r\n.face-dot {\r\n  width: 9px;\r\n  height: 9px;\r\n  border-radius: 50%;\r\n  flex-shrink: 0;\r\n  cursor: default;\r\n  transition: transform 0.15s;\r\n}\r\n \r\n.face-dot:hover {\r\n  transform: scale(1.4);\r\n}\r\n \r\n/* Green = face registered */\r\n.face-dot-registered {\r\n  background: #27ae60;\r\n  box-shadow: 0 0 0 2px rgba(39, 174, 96, 0.25);\r\n}\r\n \r\n/* Amber = face missing — matches the notification banner urgency */\r\n.face-dot-missing {\r\n  background: #e0a800;\r\n  box-shadow: 0 0 0 2px rgba(224, 168, 0, 0.25);\r\n}\r\n\r\n/* ═══════════════════════════════════════════════════════════════\r\n   COLLEGE ANALYTICS SECTION\r\n   ═══════════════════════════════════════════════════════════════ */\r\n \r\n.loading-charts {\r\n  text-align: center;\r\n  padding: 40px;\r\n  color: #888;\r\n  font-size: 14px;\r\n}\r\n \r\n.college-analytics-section {\r\n  margin: 20px 20px 24px;\r\n  padding: 20px 24px;\r\n  background: white;\r\n  border-radius: 12px;\r\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);\r\n\r\n}\r\n \r\n.section-title {\r\n  font-size: 1.1rem;\r\n  font-weight: 600;\r\n  color: var(--color-primary-dark);\r\n  margin: 0 0 18px 0;\r\n  padding-bottom: 8px;\r\n  border-bottom: 2px solid var(--color-primary);\r\n}\r\n \r\n/* Two-column chart row — pie is narrower, bar is wider */\r\n.charts-row {\r\n  display: grid;\r\n  grid-template-columns: minmax(320px, 420px) minmax(360px, 1fr);\r\n  gap: 20px;\r\n  align-items: stretch;\r\n}\r\n \r\n.chart-card {\r\n  position: relative;\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: space-between;\r\n  background: #fff;\r\n  border: 1px solid #efefef;\r\n  border-radius: 14px;\r\n  padding: 22px;\r\n  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);\r\n  min-height: 430px;\r\n}\r\n \r\n.chart-card-header {\r\n  margin-bottom: 16px;\r\n}\r\n \r\n.chart-card h4 {\r\n  margin: 0;\r\n  font-size: 15px;\r\n  font-weight: 700;\r\n  letter-spacing: 0.02em;\r\n  color: #172b4d;\r\n  text-align: left;\r\n}\r\n \r\n.chart-card-body {\r\n  flex: 1 1 auto;\r\n  min-height: 320px;\r\n}\r\n \r\n.chart-card-body .recharts-wrapper,\r\n.chart-card-body .recharts-surface,\r\n.chart-card-body svg {\r\n  width: 100% !important;\r\n  height: 100% !important;\r\n}\r\n \r\n.chart-card--pie {\r\n  flex: 0 0 420px;\r\n}\r\n \r\n.chart-card--bar {\r\n  flex: 1 1 0;\r\n  min-width: 420px;\r\n}\r\n \r\n/* ── Summary legend strip (lives inside bar chart card) ─────────────────── */\r\n.chart-summary-legend {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 10px 18px;\r\n  padding: 10px 4px 2px;\r\n  margin-top: 8px;\r\n  border-top: 1px solid #eee;\r\n}\r\n \r\n.summary-item {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  font-size: 11px;\r\n  font-weight: 700;\r\n  color: #444;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.3px;\r\n  white-space: nowrap;\r\n}\r\n \r\n.summary-item.summ