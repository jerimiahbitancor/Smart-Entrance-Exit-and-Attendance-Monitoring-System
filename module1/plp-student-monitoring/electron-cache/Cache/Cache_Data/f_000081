const __vite__css = "/* Students.css */\r\n\r\n:root {\r\n  --color-bg-main: #fcfbf4;\r\n  --color-primary: #548772;\r\n  --color-primary-dark: #01311d;\r\n  --color-accent: #d99201;\r\n  --color-accent-hover: #58761b;\r\n  --color-text-dark: #01311d;\r\n  --color-text-black: #0f0f0f;\r\n  --color-text-light: #fafafa;\r\n  --color-border-light: rgba(0, 0, 0, 0.08);\r\n  --color-shadow-soft: rgba(0, 0, 0, 0.1);\r\n  --transition: 0.28s ease;\r\n}\r\n\r\n\r\n.students{\r\n  background-color: var(--color-bg-main);\r\n}\r\n.student-management {\r\n  padding: 20px;\r\n  max-width: 1400px;\r\n  margin: 0 auto;\r\n  background-color: var(--color-bg-main);\r\n  min-height: 100vh;\r\n}\r\n\r\n/* Header Styles */\r\n.header-card {\r\n  margin-bottom: 10px;\r\n  margin-left: 2rem;\r\n}\r\n\r\n.header-card h1 {\r\n  color: var(--color-text-dark);\r\n  font-size: 24px;\r\n  margin-bottom: 5px;\r\n}\r\n\r\n.subtitle {\r\n  color: #666;\r\n  font-size: 14px;\r\n}\r\n\r\n.header-divider {\r\n  margin: 15px 0;\r\n  border: none;\r\n  border-top: 1px solid #eee;\r\n}\r\n\r\n/* Notification Section */\r\n.notification {\r\n  margin-bottom: 20px;\r\n  display: flex;\r\n  justify-content: center;\r\n  margin: 0 20px;\r\n  background-color: white;\r\n  border-radius: 8px;\r\n  box-shadow: 0 2px 4px var(--color-shadow-soft);\r\n  margin-left: 20px;\r\n  border-color: 2px solid #d97706 !important;\r\n}\r\n\r\n.notification_box{\r\n    margin: 30px;\r\n  border-color: 2px solid #d97706 !important;\r\n}\r\n\r\n.notification_wrapper {\r\n  display: flex;\r\n  gap: 15px;\r\n  padding: 15px 20px;\r\n}\r\n\r\n.notification_wrapper h3 {\r\n  font-size: 1.3rem;\r\n  color: var(--color-primary-dark);\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  font-weight: 600;\r\n  margin: 0;\r\n}\r\n\r\n.notification h3 svg {\r\n  font-size: 24px;\r\n  color: var(--color-primary);\r\n}\r\n\r\n.notification_content {\r\n  color: var(--color-text-black);\r\n}\r\n\r\n/* Controls Section */\r\n