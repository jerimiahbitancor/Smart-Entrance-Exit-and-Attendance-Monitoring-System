8px 20px rgba(0, 0, 0, 0.08);\r\n  transition: transform var(--transition), box-shadow var(--transition);\r\n  border: 1px solid rgba(255, 255, 255, 0.1);\r\n}\n.metric-card:hover {\r\n  transform: translateY(-6px);\r\n  box-shadow: 0 15px 30px rgba(1, 49, 29, 0.15);\r\n  cursor: pointer;\r\n}\n.metric-value {\r\n  font-size: 52px;\r\n  font-weight: 700;\r\n  margin-bottom: 8px;\r\n  line-height: 1.1;\r\n}\n.metric-label {\r\n  font-size: 14px;\r\n  opacity: 0.9;\r\n  line-height: 1.5;\r\n  letter-spacing: 0.5px;\r\n  text-transform: uppercase;\r\n  font-weight: 500;\r\n}\n/* LOADING & ERROR STATES */\n.loading-state,\r\n.error-state {\r\n  text-align: center;\r\n  padding: 48px;\r\n  margin: 32px 0;\r\n  border-radius: 16px;\r\n  font-size: 16px;\r\n  background-color: white;\r\n  box-shadow: 0 4px 12px var(--color-shadow-soft);\r\n  border: 1px solid var(--color-border-light);\r\n}\n.loading-state {\r\n  color: var(--color-text-dark);\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: 20px;\r\n}\n.spinner {\r\n  width: 48px;\r\n  height: 48px;\r\n  border: 4px solid var(--color-border-light);\r\n  border-top-color: var(--color-primary);\r\n  border-radius: 50%;\r\n  animation: spin 0.8s linear infinite;\r\n}\n@keyframes spin {\r\n  to { transform: rotate(360deg); }\r\n}\n@keyframes loading-pulse {\r\n  0% { background-position: 200% 0; }\r\n  100% { background-position: -200% 0; }\r\n}\n.error-state {\r\n  background-color: #fff5f5;\r\n  border: 2px solid var(--color-error);\r\n  color: var(--color-error);\r\n}\n.error-state button {\r\n  margin-top: 20px;\r\n  padding: 12px 28px;\r\n  background-color: var(--color-error);\r\n  color: white;\r\n  border: none;\r\n  border-radius: 8px;\r\n  cursor: pointer;\r\n  font-size: 15px;\r\n  font-weight: 600;\r\n  transition: all var(--transition);\r\n}\n.error-state button:hover {\r\n  background-color: #d32f2f;\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 4px 12px rgba(255, 46, 46, 0.3);\r\n}\n/* CHART SECTIONS */\n.chart-section {\r\n  background: white;\r\n  padding: 28px;\r\n  border-radius: 20px;\r\n  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.04);\r\n  margin-bottom: 32px;\r\n  border: 1px solid var(--color-border-light);\r\n  transition: transform var(--transition), box-shadow var(--transition);\r\n}\n/* TWO-CHARTS GRID LAYOUT */\n.two-charts{\r\n  display: grid;\r\n  grid-template-columns: 1fr 1fr;\r\n  gap: 20px;\r\n  margin-bottom: 32px;\r\n}\n.daily-traffic-section {\r\n  grid-column: 1 / -1;\r\n}\n.two-charts-grid .chart-section {\r\n  margin-bottom: 0;\r\n}\n.chart-section:hover {\r\n  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.06);\r\n}\n.section-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  margin-bottom: 24px;\r\n  padding-bottom: 20px;\r\n  border-bottom: 2px solid var(--color-border-light);\r\n  flex-wrap: wrap;\r\n  gap: 16px;\r\n}\n.section-header h2 {\r\n  font-size: 24px;\r\n  color: var(--color-primary-dark);\r\n  margin: 0;\r\n  font-weight: 600;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.5px;\r\n}\n/* TIME RANGE SELECTOR */\n.time-range-selector {\r\n  display: flex;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n}\n.range-btn {\r\n  padding: 10px 20px;\r\n  border: 1.5px solid #e0e0e0;\r\n  background-color: white;\r\n  color: #666666;\r\n  border-radius: 30px;\r\n  cursor: pointer;\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  transition: all var(--transition);\r\n}\n.range-btn:hover {\r\n  border-color: var(--color-primary);\r\n  color: var(--color-primary);\r\n  background-color: rgba(84, 135, 114, 0.05);\r\n}\n.range-btn.active {\r\n  background-color: var(--color-primary);\r\n  color: white;\r\n  border-color: var(--color-primary);\r\n  box-shadow: 0 4px 10px rgba(84, 135, 114, 0.3);\r\n}\n/* INFO BUTTON */\n.info-btn {\r\n  background: none;\r\n  border: 1.5px solid #e0e0e0;\r\n  font-size: 16px;\r\n  cursor: pointer;\r\n  padding: 8px 16px;\r\n  color: #666666;\r\n  border-radius: 30px;\r\n  transition: all var(--transition);\r\n  font-weight: 500;\r\n}\n.info-btn:hover {\r\n  border-color: var(--color-primary);\r\n  color: var(--color-primary);\r\n  background-color: rgba(84, 135, 114, 0.05);\r\n}\n/* INSIGHTS & TRAFFIC LEGEND */\n.traffic-insights-container {\r\n  display: flex;\r\n  gap: 24px;\r\n  margin-top: 28px;\r\n  flex-wrap: wrap;\r\n}\n.insights {\r\n  flex: 1;\r\n  min-width: 250px;\r\n  background: rgba(84, 135, 114, 0.5);\r\n  padding: 24px;\r\n  border-radius: 12px;\r\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);\r\n}\n.insights h4 {\r\n  color: var(--color-primary-dark);\r\n  margin-bottom: 16px;\r\n  font-size: 18px;\r\n  font-weight: 600;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.5px;\r\n}\n.insights ul {\r\n  list-style: none;\r\n  padding: 0;\r\n  margin: 0;\r\n}\n.insights li {\r\n  padding: 12px 0;\r\n  color: var(--color-text-dark);\r\n  line-height: 1.6;\r\n  font-size: 14px;\r\n  border-bottom: 1px dashed rgba(84, 135, 114, 0.2);\r\n}\n.insights li:last-child {\r\n  border-bottom: none;\r\n}\n.insights strong {\r\n  color: var(--color-primary-dark);\r\n  font-weight: 700;\r\n}\n.traffic-legend {\r\n  flex: 1;\r\n  min-width: 250px;\r\n  background: rgb(84, 135, 114, 0.5);\r\n  padding: 24px;\r\n  border-radius: 12px;\r\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);\r\n}\n.traffic-legend h4 {\r\n  color: var(--color-primary-dark);\r\n  margin-bottom: 20px;\r\n  font-size: 18px;\r\n  font-weight: 600;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.5px;\r\n}\n.legend-items {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n}\n.legend-item-traffic {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  padding: 12px 0;\r\n}\n.legend-color {\r\n  width: 16px;\r\n  height: 16px;\r\n  border-radius: 3px;\r\n  flex-shrink: 0;\r\n}\n.legend-color.entrance {\r\n  background-color: #58761B;\r\n}\n.legend-color.exit {\r\n  background-color: #D99201;\r\n}